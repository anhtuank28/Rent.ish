# Prisma - Chuỗi kết nối Database
# Thay đổi username, password, host, port, và tên database cho phù hợp
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Server
PORT=3001

# JWT - Khóa bí mật cho xác thực người dùng
JWT_SECRET="your-secret-key-here"

# CORS - Địa chỉ Frontend được phép gọi API
CORS_ORIGIN="http://localhost:3000"
